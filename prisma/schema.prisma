// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Urun Tablosu
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  priceText   String?
  description String
  imageUrl    String?
  category    String?
  createdDate DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  imageUrl    String?
  createdDate DateTime @default(now())
}

